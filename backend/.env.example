# ─────────────────────────────────────────────────────────────────────────────
# Nexus Map — BACKEND environment (Node / Express)
#
# Copy to backend/.env and fill in real values:   cp .env.example .env
# backend/.env is gitignored. NEVER put real secrets in this example file.
# Validated on boot by backend/src/config/env.ts (zod + dotenv).
# ─────────────────────────────────────────────────────────────────────────────

# API server port. Optional — defaults to 5000.
PORT=5000

# development | test | production. Optional — defaults to development.
NODE_ENV=development

# Allowed CORS origin (the frontend URL). Optional — defaults to the Vite dev server.
FRONTEND_URL=http://localhost:5173

# REQUIRED. TomTom API key (min 10 chars) — the server refuses to start without it.
# Powers place search, routing, traffic incidents and the map tile proxy.
TOMTOM_API_KEY=your-tomtom-api-key

# Supplementary geocoder, used for the Pakistani POIs TomTom lacks and as a
# worldwide fallback. Optional — search still works without it.
GEOAPIFY_API_KEY=your-geoapify-api-key

# Supabase project URL. Optional — without it the backend uses an in-memory store.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SERVICE-ROLE key — SECRET, full database access, bypasses RLS.
# Backend only. It must NEVER appear in a VITE_ variable or any frontend file.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI, for the AI planner / chat. Optional — the planner falls back to a
# deterministic rule-based plan when absent.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
