# ─────────────────────────────────────────────────────────────────────────────
# Nexus Map — environment
#
#   cp .env.example .env.local     and fill in real values
#
# .env.local is gitignored. Only NEXT_PUBLIC_* variables reach the browser and
# they end up in the built JavaScript, so put ONLY public values behind that
# prefix — never DATABASE_URL, NEXTAUTH_SECRET, or any provider secret.
#
# (This file previously described a Vite frontend with VITE_* variables. The
# app has since moved to Next.js; none of those names are read any more.)
# ─────────────────────────────────────────────────────────────────────────────

# ---- Required ---------------------------------------------------------------

# Postgres (Neon / Vercel Postgres). Include ?sslmode=require for hosted DBs.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Session signing secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Base URL of this app. Must match the deployed origin in production.
NEXTAUTH_URL=http://localhost:3000

# TomTom — map tiles, place search, routing and traffic. Server-side only.
TOMTOM_API_KEY=

# ---- Optional ---------------------------------------------------------------

# Google sign-in. The button stays hidden until BOTH are set.
# Create at https://console.cloud.google.com/apis/credentials (Web application):
#   Authorised JavaScript origins:  http://localhost:3000
#   Authorised redirect URIs:       http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini. Powers the Live AI voice assistant — both the brain (which
# understands commands and drives the app) and the spoken voice. Without it the
# assistant falls back to the browser's own robotic speech, and trip plans use
# the built-in planner instead of model-written prose.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which voice the assistant speaks in. Male options, deepest first:
#   Charon (default, warm and deep) · Orus (firm) · Iapetus (clear)
#   Algieba (smooth) · Umbriel (easy-going) · Gacrux (mature) · Puck (younger)
# Female options include Kore, Aoede, Leda and Zephyr.
# GEMINI_TTS_VOICE=Charon

# ---- Public (exposed to the browser) ----------------------------------------

# API base. Defaults to /api (the Next.js routes) when unset.
NEXT_PUBLIC_API_URL=/api

# Where the map opens before a GPS fix or a saved view exists.
# Note: this is only an initial view. It is deliberately NOT used to bias place
# search — biasing to a default centre returned unrelated rural results.
NEXT_PUBLIC_MAP_DEFAULT_LAT=30.3753
NEXT_PUBLIC_MAP_DEFAULT_LNG=69.3451
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=5
