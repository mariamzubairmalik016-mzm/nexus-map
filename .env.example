# ─────────────────────────────────────────────────────────────────────────────
# Nexus Map — FRONTEND environment (Vite)
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored.
#
# Only VITE_-prefixed variables reach the browser, and everything here ends up
# in the built JavaScript. Put ONLY public values in this file — never the
# Supabase service-role key, and never the TomTom / Geoapify / OpenAI keys.
# Those live in backend/.env and are reached through the backend proxy.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API root, WITHOUT the /api suffix. Set this to the deployed backend
# URL in production.
VITE_API_BASE_URL=http://localhost:5000

# Legacy alternative that already includes /api. If set it wins over
# VITE_API_BASE_URL. Existing .env files keep working unchanged.
# VITE_API_URL=http://localhost:5000/api

# Supabase project URL (public).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase ANON key — public by design and protected by Row Level Security.
# This is the ONLY Supabase key that belongs in the frontend.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Base map renderer source: "osm" (OpenStreetMap raster tiles, default) or
# "tomtom" (TomTom tiles proxied by the backend, so the key stays server-side).
VITE_MAP_PROVIDER=osm

# Where the map opens when there is no GPS fix and no saved view.
# Defaults below are the geographic centre of Pakistan.
VITE_MAP_DEFAULT_LAT=30.3753
VITE_MAP_DEFAULT_LNG=69.3451
VITE_MAP_DEFAULT_ZOOM=5
